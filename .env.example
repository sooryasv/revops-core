# Copy to .env and edit. Every value below is an obviously fake placeholder; never commit a real .env.

ENV=dev
LOG_LEVEL=INFO

# Runtime connection: role revops_app (DML only). Migrations use the owner role below.
DATABASE_URL=postgresql+asyncpg://revops_app:dev-only-app-password@localhost:5432/revops
MIGRATION_DATABASE_URL=postgresql+asyncpg://revops_owner:dev-only-owner-password@localhost:5432/revops

ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# Auth. In dev and test an ephemeral key can be generated explicitly (see docs/runbook.md); production must set this.
JWT_ISSUER=revops-core
JWT_KEY_ID=dev-1
JWT_PRIVATE_KEY_PEM=

# Payments: "fake" needs no keys. "razorpay" needs the three values below (TEST mode keys only).
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_NOT_A_REAL_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_NOT_A_REAL_SECRET

# Seed data (python -m app.cli seed-demo). Never commit a real password.
SEED_DEMO_PASSWORD=change-me-demo-only

# Demo shortcut: run alembic with the owner URL at container start. Prefer a deploy-pipeline step.
RUN_MIGRATIONS=0
